diff --git a/CSS/components.css b/CSS/components.css
index b25551a..a6f4f09 100644
--- a/CSS/components.css
+++ b/CSS/components.css
@@ -36,14 +36,16 @@ thead th{
 }
 tbody td{padding:11px 12px;border-bottom:1px solid var(--border-soft);vertical-align:middle;}
 tbody tr:hover{background:var(--surface);}
-/* The actions column has no header text, so in an auto-layout table the
-   browser was handing it whatever width was left over — stretching a
-   couple of small buttons across a huge gap. width:1% + nowrap makes it
-   (and any other shrink-to-fit column marked the same way) hug its
-   content instead. */
-thead th.col-shrink, tbody td.col-shrink{width:1%;white-space:nowrap;}
-.row-actions{display:flex;gap:6px;justify-content:flex-end;}
-.row-actions button{padding:5px 9px;font-size:12px;}
+/* width:1% + nowrap makes a shrink-to-fit column hug its content instead
+   of stretching across leftover space. padding-left gives it breathing
+   room from whatever sits to its left (a badge, a mono timestamp) so
+   adjacent shrink columns never crowd into each other — and if the
+   viewport genuinely isn't wide enough for all of them, .table-scroll
+   (layout.css) scrolls the table horizontally instead of squeezing them. */
+thead th.col-shrink, tbody td.col-shrink{width:1%;white-space:nowrap;padding-left:20px;}
+.row-actions{display:flex;flex-wrap:nowrap;gap:6px;justify-content:flex-end;}
+.row-actions button{padding:5px 9px;font-size:12px;flex-shrink:0;white-space:nowrap;}
+.badge{flex-shrink:0;}
 .empty-state{
   border:1px dashed var(--border);border-radius:6px;padding:40px 20px;text-align:center;color:var(--text-muted);
 }
diff --git a/CSS/layout.css b/CSS/layout.css
index 6230893..7eeec1e 100644
--- a/CSS/layout.css
+++ b/CSS/layout.css
@@ -1,8 +1,8 @@
 /* App shell layout: sidebar, topbar, content area. */
-#shell{flex:1;display:flex;min-height:100vh;}
+#shell{flex:1;display:flex;min-height:0;}
 #sidebar{
   width:216px;flex:0 0 216px;background:var(--surface);border-right:1px solid var(--border);
-  display:flex;flex-direction:column;padding:18px 0;
+  display:flex;flex-direction:column;padding:18px 0;overflow-y:auto;
 }
 .brand{display:flex;align-items:center;gap:9px;padding:0 18px 20px;border-bottom:1px solid var(--border-soft);margin-bottom:14px;}
 .brand .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);}
@@ -19,7 +19,7 @@ nav.rail button.active{background:var(--surface-raised);color:var(--text);}
 nav.rail button.active .ic{color:var(--accent);}
 .rail-spacer{flex:1;}
 
-#main{flex:1;min-width:0;display:flex;flex-direction:column;}
+#main{flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;}
 #topbar{
   min-height:56px;flex:0 0 auto;border-bottom:1px solid var(--border);
   display:flex;align-items:center;justify-content:space-between;gap:16px;
@@ -40,4 +40,22 @@ nav.rail button.active .ic{color:var(--accent);}
   .who-text{display:none;}
 }
 
-#content{flex:1;padding:24px;overflow:auto;}
+#content{
+  flex:1;min-height:0;padding:24px;
+  display:flex;flex-direction:column;
+  overflow-y:auto;overflow-x:hidden;
+}
+/* Table pages (.toolbar + .table-scroll + pagination) pin the toolbar and
+   pagination in place and let only the row area scroll. #content above is
+   still a scroll fallback for pages (like Test Scan) that don't use this
+   structure, so it's harmless overlap, not a second independent scrollbar
+   in practice — table pages never grow taller than #content because
+   .table-scroll absorbs the overflow itself. */
+.toolbar{flex:0 0 auto;}
+.table-scroll{
+  flex:1 1 auto;min-height:120px;overflow:auto;
+  border:1px solid var(--border-soft);border-radius:6px;
+}
+.table-scroll table{width:100%;}
+.table-scroll thead th{position:sticky;top:0;background:var(--bg);z-index:1;}
+
