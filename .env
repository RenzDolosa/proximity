APP_ENV=local
DB_HOST=0
DB_NAME=0
DB_USER=0
DB_PASS=0
DATABASE_URL=0

PORT=3000
APP_URL=http://localhost:3000
BASE_URL=0

# ── Add these lines to your .env file ─────────────────────────────────────────
# Required for device-push.php to route card swipes to the right database.
# Set user_id=1 (or whichever portal user_id owns this device).

DEVICE_DEFAULT_USER_ID=1
DEVICE_USER_MAP={"G010525JZXDD01065":1}

# Optional: set a shared secret if you want to lock the endpoint
# DEVICE_API_KEY=your-secret-here
