@@ -94,11 +104,26 @@ function renderStandaloneScanner() {
     }
     scheduleResultFade();
     codeInput.value = '';
+    codeInput.disabled = false;
     codeInput.focus();
+    scanBusy = false;
     // Only this operator's own scans, per kiosk — see get_scan_feed's
