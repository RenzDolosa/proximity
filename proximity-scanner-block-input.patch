   const doScan = async () => {
+    if (scanBusy) return; // a scan is already in flight — the debounce timer below can otherwise double-fire while awaiting the previous one
     const proximity_code = codeInput.value.trim();
     if (!proximity_code) return;
+    scanBusy = true;
