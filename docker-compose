#docker-compose.yml

version: "3.8"

services:
  # ─── PHP + Apache Web App ───────────────────────────────────────────
  app:
    build: .
    container_name: php_app
    ports:
      - "8080:80" # Visit http://localhost:8080
    volumes:
      - ./htdocs:/var/www/html # Live reload: changes reflect instantly
    environment:
      DB_HOST: db
      DB_NAME: ${DB_NAME:if0_41430152_proximity3pl} # -mydb # if0_41430152_proximity3pl
      DB_USER: ${DB_USER:root} # -myuser #
      DB_PASS: ${DB_PASS:''} # -mypassword #
    depends_on:
      db:
        condition: service_healthy # Wait until MySQL is ready
    networks:
      - app-network
    restart: unless-stopped

  # ─── MySQL Database ─────────────────────────────────────────────────
  db:
    image: mysql:8.0
    container_name: mysql_db
    ports:
      - "3306:3306" # Optional: expose for local DB tools (e.g. DBeaver)
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASS:-rootpassword}
      MYSQL_DATABASE: ${DB_NAME:-mydb}
      MYSQL_USER: ${DB_USER:-myuser}
      MYSQL_PASSWORD: ${DB_PASS:-mypassword}
    volumes:
      - db_data:/var/lib/mysql # Persist DB data between restarts
      - ./init.sql:/docker-entrypoint-initdb.d/init.sql # Optional: auto-run SQL on first start
    healthcheck:
      test:
        [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "localhost",
          "-u",
          "root",
          "-p${DB_ROOT_PASS:-rootpassword}",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-network
    restart: unless-stopped

  # ─── phpMyAdmin (optional DB GUI) ───────────────────────────────────
  phpmyadmin:
    image: phpmyadmin:latest
    container_name: phpmyadmin
    ports:
      - "8081:80" # Visit http://localhost:8081
    environment:
      PMA_HOST: db
      PMA_USER: ${DB_USER:-myuser}
      PMA_PASSWORD: ${DB_PASS:-mypassword}
    depends_on:
      - db
    networks:
      - app-network
    restart: unless-stopped

# ─── Volumes & Networks ───────────────────────────────────────────────
volumes:
  db_data:

networks:
  app-network:
    driver: bridge
