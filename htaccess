# ============================================================
#  .htaccess — HTDocs Project
# ============================================================

# ------------------------------
# 1. ENGINE & BASIC SECURITY
# ------------------------------
Options -Indexes
Options -MultiViews
ServerSignature Off

# ------------------------------
# 2. REWRITE ENGINE
# ------------------------------
RewriteEngine On
RewriteBase /

# Force HTTPS (uncomment when SSL is available)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------
# 3. FRONT-CONTROLLER ROUTING
# ------------------------------
# Send all requests to index.php UNLESS the file/folder actually exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# ------------------------------
# 4. BLOCK DIRECT ACCESS TO SENSITIVE FILES
# ------------------------------
# Protect PHP back-end files from being accessed directly
<FilesMatch "^(database|f-pass|portal|proximity|reg)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect config / hidden files
<FilesMatch "(^\.htaccess|\.gitattributes|Dockerfile|settings\.json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ------------------------------
# 5. PROTECT UPLOAD DIRECTORY
# ------------------------------
# Prevent uploaded files from being executed as scripts
<IfModule mod_php.c>
    <Directory "uploads/user">
        php_flag engine off
    </Directory>
</IfModule>

# Block script execution inside uploads
RewriteCond %{REQUEST_URI} ^/uploads/user/
RewriteRule \.(php|phtml|php3|php4|php5|phar|cgi|pl|py|sh)$ - [F,L]

# ------------------------------
# 6. SECURITY HEADERS
# ------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------
# 7. CUSTOM ERROR PAGES
# ------------------------------
ErrorDocument 403 /index.php?error=403
ErrorDocument 404 /index.php?error=404
ErrorDocument 500 /index.php?error=500

# ------------------------------
# 8. PERFORMANCE — BROWSER CACHING
# ------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png            "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 month"
    ExpiresByType image/gif            "access plus 1 month"
    ExpiresByType image/svg+xml        "access plus 1 month"
    ExpiresByType image/x-icon         "access plus 1 year"
</IfModule>

# ------------------------------
# 9. COMPRESSION
# ------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
